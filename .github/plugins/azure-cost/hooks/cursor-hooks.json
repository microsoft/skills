{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --harness cursor"
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --harness cursor"
      }
    ],
    "afterMCPExecution": [
      {
        "type": "command",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh\" --harness cursor"
      }
    ]
  }
}
