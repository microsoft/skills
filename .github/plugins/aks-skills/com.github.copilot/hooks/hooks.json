{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "windows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/scripts/track-telemetry.ps1\" -Harness copilot-vscode",
        "osx": "${PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh --harness copilot-vscode",
        "linux": "${PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh --harness copilot-vscode",
        "bash": "${PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh --harness copilot-vscode",
        "powershell": "${PLUGIN_ROOT}/hooks/scripts/track-telemetry.ps1 -Harness copilot-vscode"
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "windows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/scripts/track-telemetry.ps1\" -Harness copilot-vscode",
        "osx": "${PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh --harness copilot-vscode",
        "linux": "${PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh --harness copilot-vscode",
        "bash": "${PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh --harness copilot-vscode",
        "powershell": "${PLUGIN_ROOT}/hooks/scripts/track-telemetry.ps1 -Harness copilot-vscode"
      }
    ]
  }
}
