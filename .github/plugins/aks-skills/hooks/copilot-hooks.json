{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",

        "windows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/scripts/track-telemetry.ps1\"",
        "osx": "${PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh",
        "linux": "${PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh",

        "bash": "${PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh",
        "powershell": "${PLUGIN_ROOT}/hooks/scripts/track-telemetry.ps1",

        "env": {
          "AZURE_SKILLS_HOOK_CLIENT_FAMILY": "copilot-vscode"
        }
      }
    ],
    "PostToolUse": [
      {
        "type": "command",

        "windows": "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}/hooks/scripts/track-telemetry.ps1\"",
        "osx": "${PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh",
        "linux": "${PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh",

        "bash": "${PLUGIN_ROOT}/hooks/scripts/track-telemetry.sh",
        "powershell": "${PLUGIN_ROOT}/hooks/scripts/track-telemetry.ps1"
      }
    ]
  }
}
