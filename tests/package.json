{
  "name": "agent-skills-tests",
  "version": "1.0.0",
  "type": "module",
  "description": "Test harness for agent-skills - validates skill code generation against acceptance criteria",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "harness": "tsx harness/runner.ts",
    "harness:list": "tsx harness/runner.ts --list",
    "harness:mock": "tsx harness/runner.ts --mock"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.3",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "yaml": "^2.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@microsoft/vally": "^0.7.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.5.0",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
